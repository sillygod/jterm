#!/bin/bash
# dnscat - DNS lookup and WHOIS viewer for jterm
# Usage: dnscat <domain>
#
# Query DNS records and WHOIS information for a domain and display
# results in a visual viewer with tabs for DNS Records and WHOIS.
#
# Examples:
#   dnscat google.com
#   dnscat github.com
#   dnscat 8.8.8.8          # Reverse DNS lookup

# Show help
show_help() {
    echo "Usage: dnscat <domain>"
    echo ""
    echo "Query DNS records and WHOIS information for a domain."
    echo ""
    echo "Arguments:"
    echo "  domain    Domain name to query (e.g., google.com)"
    echo "            Can also be an IP address for reverse DNS lookup"
    echo ""
    echo "Options:"
    echo "  --help, -h    Show this help message"
    echo ""
    echo "Examples:"
    echo "  dnscat google.com"
    echo "  dnscat github.com"
    echo "  dnscat 8.8.8.8"
    exit 0
}

# Parse arguments
DOMAIN=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --help|-h)
            show_help
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
        *)
            if [[ -z "$DOMAIN" ]]; then
                DOMAIN="$1"
            else
                echo "Error: Too many arguments" >&2
                echo "Use --help for usage information" >&2
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate required argument
if [[ -z "$DOMAIN" ]]; then
    echo "Error: No domain specified" >&2
    echo "Usage: dnscat <domain>" >&2
    echo "Use --help for more information" >&2
    exit 1
fi

# Clean up domain input
# Remove protocol if present
DOMAIN="${DOMAIN#http://}"
DOMAIN="${DOMAIN#https://}"
# Remove path if present
DOMAIN="${DOMAIN%%/*}"
# Remove port if present
DOMAIN="${DOMAIN%%:*}"
# Convert to lowercase
DOMAIN=$(echo "$DOMAIN" | tr '[:upper:]' '[:lower:]')

# Basic domain/IP validation
# Allow domain names and IP addresses
if [[ ! "$DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] && \
   [[ ! "$DOMAIN" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Error: Invalid domain format: $DOMAIN" >&2
    exit 1
fi

# Build JSON payload for OSC sequence
JSON_PAYLOAD=$(cat <<EOF
{"domain":"$DOMAIN"}
EOF
)

# Send OSC 1337 sequence to trigger DNS viewer
# Format: \033]1337;ViewDNS=<json>\007
printf '\033]1337;ViewDNS=%s\007' "$JSON_PAYLOAD"
